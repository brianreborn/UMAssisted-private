# Copy to `keystore.properties` (repo root) to enable signed release builds.
# The real file and the .jks are git-ignored and must never be committed.
#
# Without this file, :app:assembleRelease still succeeds — it just produces
# *-unsigned.apk, and scripts/release.sh refuses to publish those.
#
# To generate a fresh keystore:
#
#   keytool -genkeypair \
#     -keystore release.keystore.jks \
#     -alias umassisted \
#     -keyalg RSA -keysize 4096 \
#     -validity 10950 \
#     -dname "CN=UMAssisted, OU=UMAssisted, O=UMAssisted, L=Unspecified, ST=Unspecified, C=US"
#
# WARNING: the keystore is the app's permanent signing identity. If you lose it,
# Android will refuse to install any future build as an update over an existing
# install — users would have to uninstall (losing local data) and reinstall.
# Back up both release.keystore.jks and this file somewhere durable and private.

storeFile=release.keystore.jks
storePassword=CHANGE_ME
keyAlias=umassisted
keyPassword=CHANGE_ME
